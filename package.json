{
  "name": "miilo-release-caretaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based release checks orchestrated with Mastra",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "tsc --noEmit && node tools/check-architecture.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx src/main.ts",
    "journey": "node --import tsx src/journey.ts",
    "model:smoke": "node --import tsx src/model-smoke.ts",
    "showcase": "node --import tsx src/showcase.ts",
    "miilo:export": "node --import tsx integration/miilo/src/export.ts",
    "check:miilo": "tsc -p integration/miilo/tsconfig.json",
    "test:miilo": "node --import tsx --test integration/miilo/test/*.test.ts",
    "test:helper": "node --import tsx --test integration/miilo/native-tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.14",
    "@mastra/core": "1.78.0",
    "@mastra/libsql": "1.26.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
